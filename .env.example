# Copy to .env (same directory) and adjust. Every value has a default in
# compose.yaml — this file only exists for the knobs you'd likely change.

# Host port for the UI / API (bound to 127.0.0.1 only — see SECURITY.md)
PORT=8100

# Opt in to a bundled ollama container (needs a GPU): docker compose --profile local-ollama up
COMPOSE_PROFILES=local-ollama

# Local model to use (https://ollama.com/library — 3b runs on 6GB VRAM)
MODEL=qwen2.5:3b

# Use a remote GPU box's ollama instead of the local profile:
# OLLAMA_URL=http://host.docker.internal:11434

# SearXNG instance for web_search (its host port):
# SEARX_URL=http://host.docker.internal:8095

# Full JSON override of any config/policy key (see harness.toml [policy]):
# HARNESS_CONFIG={"policy":{"auto_approve":["shell","write_file"]}}
