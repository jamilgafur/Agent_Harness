     "deps": ["results", "related"],
     "success_predicate": "conclusion reflects the results"},
    {"id": "assemble", "intent": "concatenate all sections into paper/paper.md",
     "tool": "shell",
     "args": {"cmd": "cd paper && cat 01_intro.md 02_methodology.md 03_related_work.md 04_results.md 05_conclusion.md > paper.md && wc -l paper.md"},
