{
  "nodes": [
    {"id": "refs_a", "intent": "find papers on LLM multi-agent task decomposition",
     "tool": "web_search",
     "args": {"query": "LLM multi-agent task decomposition DAG survey"},
     "success_predicate": "returns at least 3 relevant results"},
    {"id": "refs_b", "intent": "find papers on adaptive dependency graphs for agents",
     "tool": "web_search",
     "args": {"query": "adaptive dependency graph LLM agents dynamic replanning"},
     "success_predicate": "returns at least 3 relevant results"},
    {"id": "refs", "intent": "collect the found citations into paper/refs.bib",
     "tool": "write_file",
     "args": {"path": "paper/refs.bib", "content": "% citations collected from web_search results\n"},
     "deps": ["refs_a", "refs_b"],
     "success_predicate": "paper/refs.bib exists with entries from both searches"},
    {"id": "intro", "intent": "write paper/01_intro.md",
     "tool": "write_file",
     "args": {"path": "paper/01_intro.md", "content": "# Introduction\n\n(draft)\n"},
     "success_predicate": "intro section exists"},
    {"id": "methods", "intent": "write paper/02_methodology.md",
     "tool": "write_file",
     "args": {"path": "paper/02_methodology.md", "content": "# Methodology\n\n(draft)\n"},
     "success_predicate": "methodology section exists"},
    {"id": "results", "intent": "write paper/04_results.md from the experiment notes",
     "tool": "write_file",
     "args": {"path": "paper/04_results.md", "content": "# Results\n\n(draft)\n"},
     "deps": ["methods"],
     "success_predicate": "results section exists"},
    {"id": "related", "intent": "write paper/03_related_work.md citing refs.bib",
     "tool": "write_file",
     "args": {"path": "paper/03_related_work.md", "content": "# Related Work\n\n(draft)\n"},
